{
  "resourceType": "Questionnaire",
  "id": "demo-expressions",
  "url": "https://formbox.healthsamurai.dev/Questionnaire/demo-expressions",
  "title": "Expressions",
  "description": "calculatedExpression and enableWhenExpression recomputed on each full-form post.",
  "status": "active",
  "item": [
    {
      "linkId": "base",
      "text": "Base",
      "type": "integer"
    },
    {
      "linkId": "double",
      "text": "Double",
      "type": "integer",
      "readOnly": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%resource.item.where(linkId='base').answer.valueInteger.last() * 2"
          }
        }
      ]
    },
    {
      "linkId": "adult-note",
      "text": "Adult note",
      "type": "string",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-enableWhenExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%resource.item.where(linkId='base').answer.valueInteger.last() >= 18"
          }
        }
      ]
    }
  ]
}
