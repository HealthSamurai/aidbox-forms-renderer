{{!--
Template: Flyover

Inputs:
- id: tooltip id.
- children: rendered flyover content.
- ariaLabel: button accessible label.
--}}
<span>
  <button type="button"{{{attr "aria-describedby" id}}}{{{attr "aria-label" ariaLabel}}}>i</button>
  <span{{{attr "id" id}}} role="tooltip">{{{children}}}</span>
</span>
